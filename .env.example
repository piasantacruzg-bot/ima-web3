# === Supabase (required) ===
# From your Supabase project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — bypasses Row Level Security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Social platform APIs (optional — required only to enable that
# platform's live sync; see /settings/integrations in the app and
# API_INTEGRATIONS.md). Until these are set, the app never fakes automatic
# sync — content/metrics stay in "manual" collection mode for that
# platform, and every adapter's connect() reports itself unconfigured
# rather than returning fabricated data. ===

# Instagram / Meta (Graph API — requires a Meta developer app + Instagram
# professional account + app review for the relevant permissions)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# TikTok (TikTok for Developers — requires app approval)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# X (requires elevated API access for metrics)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# YouTube (Google Cloud project with YouTube Data API v3 enabled)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Google Drive (Story evidence storage — separate Google Cloud OAuth
# client from YouTube's, scoped only to drive.file)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# === Integration token encryption (required once any of the above are
# set — lib/integrations/token-store.ts refuses to store a token without
# it). A 32-byte key, base64-encoded, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse this across environments; rotating it invalidates every
# stored token (they'd need to be reconnected). ===
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# === Scheduled sync (optional — see API_INTEGRATIONS.md "Scheduled
# sync"). /api/cron/sync checks this exact header before doing anything;
# without it set, the route always returns 401 and nothing runs
# automatically — manual "Sync now" / "Sync all connected accounts"
# keep working either way. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On Vercel, setting this env var also makes Vercel Cron send it
# automatically as `Authorization: Bearer <value>` when it calls the
# route on vercel.json's schedule. ===
CRON_SECRET=

# === Notification email delivery (optional — see the "Notificaciones
# por email" note in API_INTEGRATIONS.md-adjacent docs / ask in chat).
# Without these, notifications still get created and shown in the
# notifications table — they just don't get emailed; nothing here can
# silently fail into a fake "sent" state. Get RESEND_API_KEY from
# https://resend.com (free tier is plenty for an internal tool).
# NOTIFICATION_EMAIL_FROM must be a verified sender/domain in your
# Resend account, e.g. "Creator Campaign OS <notifications@yourdomain.com>"
# — or use Resend's sandbox sender (onboarding@resend.dev) while testing
# without a verified domain. ===
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# Optional — included as a link in notification emails. Your app's real
# URL once deployed (e.g. https://your-project.vercel.app). Omit to
# send emails without a link back to the app.
NEXT_PUBLIC_APP_URL=

# === AI campaign matching (optional — brief parser, Phase 8) ===
ANTHROPIC_API_KEY=

# === Legacy WhatsApp/Telegram reports tool (see legacy/whatsapp-reports) ===
# Not used by Creator Campaign OS. Only needed if you run the legacy tool
# standalone.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
