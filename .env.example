# ============================================================
# Aura · IMA WEB3 — environment configuration
# ============================================================

# --- Google Drive storage (monthly Excel workbooks) ---------
# The app connects to your Google account via OAuth and reads/writes
# Excel workbooks inside a single Drive folder.
#
# Folder that everything is stored in (Finance Tracker/... lives here):
GOOGLE_DRIVE_FOLDER_ID=11iXBsH_9SpoaqqS5nBPDKVxkEVse4mb4

# OAuth client credentials:
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Enable the "Google Drive API"
# 3. Create an OAuth 2.0 Client ID (type: Web application)
# 4. Add the redirect URI below to the client's authorized redirect URIs
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT=http://localhost:3000/api/auth/google/callback

# Obtain this once by visiting /api/auth/google in the running app and
# approving access — the callback page prints the refresh token to paste here.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Shared secret protecting the weekly /api/backup cron (optional but recommended).
CRON_SECRET=

# --- Legacy: Google Sheets influencer reporting (optional) --
# Only needed if you still use the original reporting endpoints.
GOOGLE_SHEET_ID=11O5jSSMTzYrA4kW3Q1Fkfgo5w24uolvhiJ8ZPcS--ws
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
