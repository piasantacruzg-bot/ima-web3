# === Supabase (required) ===
# From your Supabase project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — bypasses Row Level Security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Social platform APIs (optional — required only to enable that
# platform's live sync; see /integrations in the app and API_INTEGRATIONS.md).
# Until these are set, the app never fakes automatic sync — content/metrics
# stay in "manual" collection mode for that platform. ===

# Instagram / Meta (Graph API — requires a Meta developer app + Instagram
# professional account + app review for the relevant permissions)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# TikTok (TikTok for Developers — requires app approval)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# X (requires elevated API access for metrics)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# YouTube (Google Cloud project with YouTube Data API v3 enabled)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# === AI campaign matching (optional — brief parser, Phase 8) ===
ANTHROPIC_API_KEY=

# === Legacy WhatsApp/Telegram reports tool (see legacy/whatsapp-reports) ===
# Not used by Creator Campaign OS. Only needed if you run the legacy tool
# standalone.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
