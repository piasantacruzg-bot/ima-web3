# === Google Sheets (master sheet en tu Drive) ===
# ID de la master sheet. La que cree para IMA WEB3 es:
GOOGLE_SHEET_ID=11O5jSSMTzYrA4kW3Q1Fkfgo5w24uolvhiJ8ZPcS--ws

# Nombre de la pestaña dentro de la hoja (por defecto la primera se llama "Hoja 1" o "Sheet1")
GOOGLE_SHEET_TAB=Sheet1

# === Credenciales de la cuenta de servicio de Google ===
# 1. Crea un proyecto en https://console.cloud.google.com
# 2. Activa "Google Sheets API"
# 3. Crea una "Service Account" y genera una clave JSON
# 4. Comparte la master sheet (boton Compartir) con el email de la cuenta de servicio, como Editor
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@tu-proyecto.iam.gserviceaccount.com

# La clave privada del JSON. Mantén los \n literales o pega el contenido entre comillas.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
